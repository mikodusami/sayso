# Copy to api/.env. Everything is optional for local development: with no
# values, Sayso runs on a fake PayPal, heuristic AI and a local PGlite database.

# --- where things run ---------------------------------------------------------
PORT=8787
PUBLIC_API_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5180

# --- database -----------------------------------------------------------------
# pglite (local folder, default) or postgres (Neon). Vercel needs postgres.
DATABASE_DRIVER=pglite
PGLITE_DIR=./.data/pglite
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- PayPal -------------------------------------------------------------------
# fake (default, no accounts) or paypal (real sandbox).
PAYMENTS_DRIVER=fake
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/http

# Sandbox REST apps. The seed stores them (encrypted) on the demo tenants.
SEED_MERCHANT_PAYPAL_CLIENT_ID=
SEED_MERCHANT_PAYPAL_SECRET=
SEED_MERCHANT_WEBHOOK_ID=
SEED_MERCHANT_PAYPAL_EMAIL=
SEED_AGENT_PAYPAL_CLIENT_ID=
SEED_AGENT_PAYPAL_SECRET=
SEED_AGENT_WEBHOOK_ID=

# --- AI -----------------------------------------------------------------------
# heuristic (default, offline) or gateway (Vercel AI Gateway).
AI_DRIVER=heuristic
# AI_GATEWAY_API_KEY=
AI_MODEL_FAST=anthropic/claude-haiku-5.5
AI_MODEL_SMART=anthropic/claude-sonnet-5.5

# --- secrets (required in production) ------------------------------------------
# openssl rand -base64 32
# SAYSO_ENCRYPTION_KEY=
# openssl rand -base64 32
# SAYSO_LINK_SECRET=
DEMO_ADMIN_TOKEN=dev-admin
