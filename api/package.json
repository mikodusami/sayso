{
  "name": "@sayso/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.93",
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "ai": "^7.0.166",
    "canonicalize": "^5.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "Sayso API service",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke-paypal.ts",
    "demo:flow": "tsx scripts/demo-flow.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
